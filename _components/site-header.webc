<header>
    <div id="banner-logo"></div>
    <div id="banner-title">
      LostInBrittany's tech blog  
    </div>
    <div id="banner-menu">
      <nav>
        <script webc:type="js" webc:root>
          `<a href="${$data.links[$data.locale].home.url}">${$data.links[$data.locale].home.name}</a>
          <a href="${$data.links[$data.locale].talks.url}">${$data.links[$data.locale].talks.name}</a>
          <a href="${$data.links[$data.locale].geek_blog.url}" target="_blank">${$data.links[$data.locale].geek_blog.name}</a>
          <a href="${$data.links[$data.locale].about.url}">${$data.links[$data.locale].about.name}</a>
          <a href="${$data.links[$data.locale].rss.url}">${$data.links[$data.locale].rss.name}</a>`
        </script>
      </nav>
      <div id="language-picker">
        <script webc:type="js" webc:root>
          (() => {
            const languages = [
              { code: 'en', name: 'English', url: '/' },
              { code: 'fr', name: 'Français', url: '/fr/' },
              { code: 'es', name: 'Español', url: '/es/' },
            ];
            const currentLocale = ($data.locale || 'en').toLowerCase();
            return `
              <details class="language-dropdown">
                <summary aria-label="Select language">
                  <span class="language-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img" focusable="false">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" />
                    </svg>
                  </span>
                  <span class="language-code">${currentLocale.toUpperCase()}</span>
                  <span class="language-caret" aria-hidden="true">▾</span>
                </summary>
                <ul>
                  ${languages.map(lang => `
                    <li>
                      <a href="${lang.url}" class="${lang.code === currentLocale ? 'active' : ''}">
                        ${lang.name}
                      </a>
                    </li>
                  `).join('')}
                </ul>
              </details>
            `;
          })()
        </script>
      </div>
    </div>
</header>

<style webc:scoped>
  header { 
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.92), rgba(56, 189, 248, 0.75));
    display: flex;
    flex-flow: column nowrap;
    font-family: var(--header-font);
    font-weight: 400;
    --text-color: #f8fafc;
    color: var(--text-color);
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.18);
  }
  #banner-menu {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    justify-content: center;
    column-gap: 1.5rem;
    font-size: 1rem;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
  }
  #banner-menu nav {
    display: flex;
    flex-flow: row wrap;
    column-gap: 2rem;
    row-gap: 0.5rem;
    justify-content: center;
  }
  #banner-menu a {
    color: var(--text-color);
    text-decoration: none;
    cursor: pointer;
  }
  #banner-menu a.active {
    font-weight: 600;
  }
  #language-picker {
    position: relative;
  }
  .language-dropdown {
    position: relative;
  }
  .language-dropdown summary {
    list-style: none;
    display: flex;
    align-items: center;
    column-gap: 0.5rem;
    cursor: pointer;
    background: rgba(244, 246, 251, 0.18);
    border: 1px solid rgba(148, 163, 184, 0.35);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    backdrop-filter: blur(2px);
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .language-dropdown summary::-webkit-details-marker {
    display: none;
  }
  .language-dropdown summary:hover,
  .language-dropdown[open] summary,
  .language-dropdown summary:focus-visible {
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(37, 99, 235, 0.55);
    box-shadow: 0 0.35rem 0.75rem rgba(15, 23, 42, 0.18);
    outline: none;
  }
  .language-icon svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--text-color);
    stroke-width: 1.5;
  }
  .language-code {
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    color:  var(--text-color);
  }
  .language-caret {
    font-size: 0.75rem;
    transform: translateY(-0.05rem);
  }
  .language-dropdown ul {
    position: absolute;
    right: 0;
    background: rgba(244, 246, 251, 0.95);
    border: 1px solid rgba(148, 163, 184, 0.4);
    border-radius: 0.5rem;
    padding: 0.5rem;
    margin-top: 0.5rem;
    min-width: 10rem;
    box-shadow: 0 0.45rem 1.1rem rgba(15, 23, 42, 0.2);
    display: flex;
    flex-direction: column;
    row-gap: 0.25rem;
    background-clip: padding-box;
  }
  .language-dropdown li {
    list-style: none;
  }
  .language-dropdown a {
    color: var(--color-text);
    display: block;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    cursor: pointer;
  }
  .language-dropdown a:hover,
  .language-dropdown a.active {
    background-color: rgba(56, 189, 248, 0.18);
  }
  #banner-logo {
    background-image: url(/img/banner.png);
    background-size: contain;
    background-repeat: no-repeat; 
    background-position: center;
    height: 250px;
    margin-top: 1rem;
  }
  #banner-title {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 1rem;
    margin-top: 1rem;
    color: var(--text-color);
  }
  @media (width < 800px) {
    #banner-logo {
      height: 200px;
    }
  }
  @media (width < 600px) {
    #banner-logo {
      height: 150px;
    }
    .language-dropdown ul {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
    }
  }  
</style>
