<script webc:setup>
  function getSocialImage(thumbnail) {
    return thumbnail ? `https://lostinbrittany.dev/img/${thumbnail}` : global.defaultSocialImage;
  }
</script>

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="/img/favicon.png" type="image/png">

<meta name="author" :content="global.author">
<meta name="description" :content="global.description">

<meta property="og:title" :content="global.title">
<meta name="twitter:title" :content="global.title">
<meta property="og:description" :content="global.description">
<meta property="twitter:description" :content="global.description">
<meta property="og:image" :content="getSocialImage(thumbnail)">
<meta name="twitter:image" :content="getSocialImage(thumbnail)">
<meta name="twitter:card" content="summary_large_image">
<meta property="og:url" :content="url">

<link rel="preconnect" href="https://fonts.googleapis.com"  webc:keep>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin  webc:keep>
<link href="https://fonts.googleapis.com/css2?family=Antonio&display=swap" rel="stylesheet"  webc:keep>
<link rel="stylesheet" href="/css/main.css" webc:keep>
<link webc:if="canonical_url" rel="canonical" :href="canonical_url">
