<script webc:setup>
  // Scoping rules this component relies on (verified against a build):
  //  - Attribute expressions below only see values passed as props at the call
  //    site (`:@name="..."`). The `:name="..."` form is a plain attribute and is
  //    discarded by `webc:nokeep`, so it never reaches here.
  //  - A `webc:setup` block cannot read per-page data: `page`, `title`,
  //    `description` etc. resolve to a single shared object for the whole build
  //    and would be stale on every page but one. Only site-wide `global` is
  //    identical everywhere and therefore safe to read here.
  // Hence: helpers read `global`, and every page-specific value arrives as an
  // argument. Never introduce a setup-scope binding named after a prop - it
  // shadows the prop wherever a layout forgets to pass it.
  function siteUrl() {
    return global.baseUrl.replace(/\/$/, "");
  }
  function getAuthor() {
    return global.author;
  }
  function getTitle(title) {
    return String(title || global.title).trim();
  }
  function getDescription(description) {
    return String(description || global.description).trim();
  }
  function getSocialImage(social) {
    if (!social) return global.defaultSocialImage;
    if (/^https?:\/\//.test(social)) return social;
    return `${siteUrl()}/img/${social.replace(/^\//, "")}`;
  }
  function getUrl(url) {
    if (!url) return siteUrl();
    if (/^https?:\/\//.test(url)) return url;
    return siteUrl() + (url.startsWith("/") ? url : `/${url}`);
  }
</script>

<title @html="getTitle(title)"></title>

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="/img/favicon.png" type="image/png">

<meta name="author" :content="getAuthor()">
<meta name="description" :content="getDescription(description)">

<meta property="og:title" :content="getTitle(title)">
<meta name="twitter:title" :content="getTitle(title)">
<meta property="og:description" :content="getDescription(description)">
<meta name="twitter:description" :content="getDescription(description)">
<meta property="og:image" :content="getSocialImage(social)">
<meta name="twitter:image" :content="getSocialImage(social)">
<meta name="twitter:card" content="summary_large_image">
<meta property="og:url" :content="getUrl(url)">

<link rel="preconnect" href="https://fonts.googleapis.com"  webc:keep>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin  webc:keep>
<link href="https://fonts.googleapis.com/css2?family=Antonio&display=swap" rel="stylesheet"  webc:keep>
<link rel="stylesheet" href="/css/main.css" webc:keep>
<link webc:if="canonical_url" rel="canonical" :href="canonical_url">
