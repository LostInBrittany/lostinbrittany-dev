<script webc:setup>
  function getFullTitle(date,event,title) {
    return `${new Date(date).toISOString().split('T')[0]} - ${event} - ${title}`;
  }
  function getDescription(date,event, title, location) {
    return `"${title}", a talk by Horacio Gonzalez (LostInBrittany) at ${event} (${location}) on ${new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}.`;
  }
  function getSlug(url) {
    return url.split('/').at(-2);
  }
  function getYear(date) {
    return new Date(date).getFullYear();
  }
  function getSocialImage(date, url) {
    return 'talks/' + getYear(date) + '/' + getSlug(url) + '.jpg';
  }
  function getThumbnail(date, url) {
    return '/img/talks/' + getYear(date) + '/' + getSlug(url) + '.jpg';
  }
</script>


<!doctype html>
<html lang="en">
<head>
  <meta webc:is="head-commons" webc:nokeep :@title="getFullTitle(date, event, title)" :@url="page.url" :@social="getSocialImage(date, page.url)" :@canonical_url="canonical_url" :@description="getDescription(date, event, title, location)">

  <!-- Default bucket -->
  <style @raw="getBundle('css')" webc:keep></style>
  <script @raw="getBundle('js')" webc:keep></script>
</head>
<body>

  <main>
    <site-header></site-header>
    <talk-detail
      :@title="title"
      :@event="event"
      :@event_url="event_url"
      :@date="date"
      :@location="location"
      :@language="language"
      :@slides_pdf="slides_pdf"
      :@slides_url="slides_url"
      :@video_url="video_url"
      :@talk_tags="talk_tags"
      :@displayed_content="content"
      :@url="page.url"
      :@filePathStem="page.filePathStem"
      :@thumbnail="getThumbnail(date, page.url)"
    ></talk-detail>
    <site-footer></site-footer>
  </main>
</body>
</html>
<style>
  .talk-detail {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }
  .links a {
    margin-right: 1rem;
  }
</style>
