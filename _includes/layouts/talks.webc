<script webc:setup>
const talksByYear = {};
// Group talks by year
for (const talk of [...collections.talks].reverse()) {
  const year = new Date(talk.data.date).getFullYear();
  // I want to avoid the NaN year
  if (Number.isFinite(year)) {
    if (!talksByYear[year]) {
      talksByYear[year] = [];
    }
    talksByYear[year].push(talk);
  }
}

// Get a sorted list of years (descending)
const years = Object.keys(talksByYear).sort((a, b) => b - a);

function formatTalkDate(dateString) {
  if (!dateString) return '';
  const date = new Date(dateString);
  // Format date to show only month and day, as year is in the heading
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
}

// Strip a leading postcode (e.g. "79000 Niort, France" -> "Niort, France").
function cleanLocation(location) {
  return (location || '').replace(/^\s*\d{4,6}\s+/, '').trim();
}

// Map a talk language code to a short badge label + full name (for the title
// attribute). Returns null for unknown/missing codes so the badge is skipped.
function langInfo(code) {
  // Flag is decorative (aria-hidden in the markup); the EN/FR/ES code + label
  // carry the meaning, since a flag denotes a country rather than a language.
  const map = {
    en: { code: 'EN', label: 'In English', flag: '\u{1F1EC}\u{1F1E7}' },
    fr: { code: 'FR', label: 'In French', flag: '\u{1F1EB}\u{1F1F7}' },
    es: { code: 'ES', label: 'In Spanish', flag: '\u{1F1EA}\u{1F1F8}' },
  };
  return map[(code || '').toLowerCase()] || null;
}

// Prefer the self-hosted PDF as the direct "Slides" link, fall back to the
// hosted slide deck (noti.st) when no PDF is recorded.
function slidesLink(talk) {
  return talk.data.slides_pdf || talk.data.slides_url || '';
}

// Headline stats, computed from the talks collection so they stay in sync as
// talks are added. City = full cleaned location; country = its last segment.
const statCities = new Set();
const statCountries = new Set();
for (const talk of collections.talks) {
  const loc = cleanLocation(talk.data.location);
  if (!loc) continue;
  statCities.add(loc);
  const country = loc.split(',').pop().trim();
  if (country) statCountries.add(country);
}
// Count only real, dated talks: the talks listing page itself inherits the
// "talks" tag from talks.json but has no date, so exclude undated entries.
const talkCount = collections.talks.filter(
  (talk) => Number.isFinite(new Date(talk.data.date).getFullYear())
).length;
const cityCount = statCities.size;
const countryCount = statCountries.size;

// Build the marker list for <granite-worldmap>: one marker per city (grouped
// by coordinates). Each marker's popup lists every talk given there (event +
// year), its hover tooltip shows the place, and its `intensity` (1..5) makes
// cities with many talks read denser. Serialized to JSON, parsed client-side.
const cityByCoords = new Map();
for (const talk of collections.talks) {
  const { lat, lng } = talk.data;
  if (typeof lat !== 'number' || typeof lng !== 'number') continue;
  const key = `${lat},${lng}`;
  if (!cityByCoords.has(key)) {
    // Strip a leading postcode (e.g. "79000 Niort, France" -> "Niort, France").
    const place = (talk.data.location || '').replace(/^\s*\d{4,6}\s+/, '').trim();
    cityByCoords.set(key, { lat, lng, title: place, entries: [] });
  }
  const year = String(new Date(talk.data.date).getUTCFullYear());
  // Some event names already carry the year (e.g. "DevBcn 2025"); drop a
  // trailing duplicate so the popup row doesn't read "DevBcn 2025 - 2025".
  const label = (talk.data.event || '').replace(new RegExp(`[\\s\\-–—]*${year}$`), '').trim();
  cityByCoords.get(key).entries.push({
    label,
    meta: year,
    url: talk.url,
    date: talk.data.date,
  });
}
const mapLocations = [...cityByCoords.values()].map(city => ({
  lat: city.lat,
  lng: city.lng,
  title: city.title,
  intensity: Math.min(city.entries.length, 5),
  // Newest talk first; drop the sort-only `date` field from the payload.
  entries: city.entries
    .sort((a, b) => new Date(b.date) - new Date(a.date))
    .map(({ label, meta, url }) => ({ label, meta, url })),
}));
const mapLocationsJson = JSON.stringify(mapLocations);
</script>

<!doctype html>
<html lang="en">
<head>
  <meta webc:is="head-commons" webc:nokeep :@title="page.title" :@global="global" :@url="page.url" >
  <style @raw="getBundle('css')" webc:keep></style>
  <script @raw="getBundle('js')" webc:keep></script>
</head>
<body>
  <main>
    <site-header></site-header>
    <div class="talks-list">
      <h1 @text="title"></h1>
      <p class="talks-stats">
        <span class="stat"><span class="stat-num" @text="talkCount"></span> talks</span>
        <span class="stat"><span class="stat-num" @text="cityCount"></span> cities</span>
        <span class="stat"><span class="stat-num" @text="countryCount"></span> countries</span>
      </p>
      <p class="talks-stats-note">
        These are my talks since I joined <a href="https://clever-cloud.com">Clever Cloud</a> in 2024 &mdash; I'm gradually adding my earlier ones.
      </p>
      <div webc:for="year of years">
        <h2 id="year" @text="year"></h2>
        <ul class="talks">
          <li class="talk" webc:for="talk of talksByYear[year]">
            <a class="talk-title" :href="talk.url" @text="talk.data.title"></a>
            <div class="talk-meta">
              <span class="talk-where">
                <span class="talk-event">
                  <a webc:if="talk.data.event_url" :href="talk.data.event_url" target="_blank" rel="noopener" @text="talk.data.event"></a>
                  <span webc:if="!talk.data.event_url" @text="talk.data.event"></span>
                </span>
                <span class="talk-location" webc:if="cleanLocation(talk.data.location)" @text="cleanLocation(talk.data.location)"></span>
                <span class="talk-lang" webc:if="langInfo(talk.data.language)" :title="langInfo(talk.data.language).label">
                  <span class="talk-flag" aria-hidden="true" @text="langInfo(talk.data.language).flag"></span>
                  <span @text="langInfo(talk.data.language).code"></span>
                </span>
                <span class="talk-date" @text="formatTalkDate(talk.data.date)"></span>
              </span>
              <!-- Video first so the always-present Slides link stays right-aligned across rows. -->
              <span class="talk-links" webc:if="slidesLink(talk) || talk.data.video_url">
                <a class="talk-link" webc:if="talk.data.video_url" :href="talk.data.video_url" target="_blank" rel="noopener">Video</a>
                <a class="talk-link" webc:if="slidesLink(talk)" :href="slidesLink(talk)" target="_blank" rel="noopener">Slides</a>
              </span>
            </div>
          </li>
        </ul>
      </div>
    </div>
    <section class="talks-map">
      <h2>Where I've been speaking</h2>
      <granite-worldmap id="talks-worldmap"></granite-worldmap>
    </section>
    <site-footer></site-footer>
  </main>
  <!-- Marker data produced server-side from the talks collection. -->
  <script type="application/json" id="talks-worldmap-data" @html="mapLocationsJson" webc:keep></script>
  <script type="module" webc:keep>
    import 'https://esm.sh/@granite-elements/granite-worldmap@1.2.0/granite-worldmap.js';
    const el = document.getElementById('talks-worldmap');
    el.locations = JSON.parse(document.getElementById('talks-worldmap-data').textContent);
  </script>
</body>
</html>
<style>
  .talks-list {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem;
  }
  /* Headline stats below the title. */
  .talks-list .talks-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    margin: 0.5rem 0 0.4rem;
    font-size: 1.1rem;
    color: var(--color-text);
  }
  .talks-list .talks-stats .stat-num {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-right: 0.15rem;
  }
  .talks-list .talks-stats-note {
    text-align: center;
    max-width: 80ch;
    margin: 0 auto 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .talks-list .talks {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .talks-list .talk {
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid #eee;
  }
  .talks-list .talk:hover {
    background-color: #f9f9f9;
  }
  .talks-list .talk-title {
    text-decoration: none;
    font-weight: bold;
    color: var(--link-color);
  }
  .talks-list .talk-title:hover {
    text-decoration: underline;
  }
  /* Meta line: where/when on the left, slides/video links pushed to the right;
     wraps below the title on narrow screens. */
  .talks-list .talk-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    row-gap: 0.25rem;
    margin-top: 0.3rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
  .talks-list .talk-where {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }
  /* Dot separators between present meta items only. */
  .talks-list .talk-where > * + *::before {
    content: "\00b7";
    margin-right: 0.5rem;
    color: var(--color-text-muted);
  }
  .talks-list .talk-event a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .talks-list .talk-event a:hover {
    text-decoration: underline;
  }
  .talks-list .talk-lang {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .talks-list .talk-flag {
    font-size: 0.95rem;
    letter-spacing: normal;
  }
  .talks-list .talk-links {
    margin-left: auto;
    display: inline-flex;
    gap: 0.5rem;
  }
  .talks-list .talk-link {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .talks-list .talk-link:hover {
    background: var(--color-accent);
    color: #fff;
  }
  #year {
    text-align: center;
  }
  .talks-map {
    margin: 1rem 0 3rem;
    padding: 0 2rem;
  }
  .talks-map h2 {
    text-align: center;
  }
  #talks-worldmap {
    --granite-worldmap-height: 500px;
    --granite-worldmap-border-radius: 12px;
    --granite-worldmap-marker-color: var(--color-accent);
    --granite-worldmap-marker-border-color: #fff;
    /* Floor/ceiling for the intensity opacity ramp: a one-talk city sits at
       0.5, the busiest (5+) at full opacity, so density reads clearly. */
    --granite-worldmap-marker-opacity: 0.5;
    --granite-worldmap-marker-intensity-max-opacity: 1;
    --granite-worldmap-popup-meta-color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }
</style>
